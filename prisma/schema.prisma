// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  nickname  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  journals     Journal[]
  moods        Mood[]
  goals        Goal[]
  streaks      Streak[]
  petSettings  PetSettings?
}

model Journal {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  mood      String   // 'good', 'neutral', 'bad', 'stress', 'meh'
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Mood {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  mood      String   // 'good', 'neutral', 'bad', 'stress', 'meh', 'untracked'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  icon        String?
  period      String   @default("Daily") // 'Daily', 'Weekly', 'Biweekly', 'Monthly'
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Streak {
  id            String   @id @default(uuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PetSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  petName   String?
  petType   String?  @default("default")
  petLevel  Int      @default(1)
  petXp     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
